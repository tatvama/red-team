# Copy to deploy/compose/.env. Never commit the filled-in file.

# Pin images you have tested on your GPU and driver.
VLLM_IMAGE=vllm/vllm-openai:<tested-tag>
TATVAM_IMAGE=tatvam-agent:0.1.0

# Model served by vLLM (a Hugging Face repo id or a local path inside the hf-cache volume).
VLLM_MODEL=
# Tool-call parser for that model family; see the vLLM docs for your version (for example hermes, qwen3_coder).
VLLM_TOOL_PARSER=
VLLM_MAX_MODEL_LEN=65536
VLLM_GPU_COUNT=1
VLLM_GPU_MEMORY_UTILIZATION=0.90
# A long random string shared by vLLM and the agent: openssl rand -hex 32
VLLM_API_KEY=
# Only for gated models.
HF_TOKEN=

# Agent
CONTEXT_TOKENS=60000
MAX_OUTPUT_TOKENS=8192
WORKSPACE_HOST_DIR=./workspace
COMMAND_RUNNER=off
GITHUB_TOKEN=

# Web search (pick one). With --profile search: SEARCH_PROVIDER=searxng and SEARXNG_URL=http://searxng:8080
SEARXNG_IMAGE=searxng/searxng:<tested-tag>
SEARCH_PROVIDER=
SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=

# Direct access through a TLS reverse proxy (leave empty when you use an SSH tunnel).
ALLOWED_HOSTS=
ACCESS_TOKEN=
