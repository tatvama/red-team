# Copy to .env.local and fill in what you use. Restart the app after changes.
# Never commit .env.local: it holds your model URLs and API keys.

# ── Models ──────────────────────────────────────────────────────────────────
# Any OpenAI-compatible server works: Ollama, vLLM, llama.cpp server, LM Studio, TGI.
# The browser only ever chooses "Local Ollama" or "GPU server"; URLs and keys stay here.

# Ollama on this machine (default shown). Set OLLAMA_API_KEY only if a proxy requires one.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=

# Your GPU server, e.g. vLLM started with --api-key. Must be https:// unless it is
# reached over loopback (an SSH tunnel such as http://127.0.0.1:8000/v1).
GPU_BASE_URL=
GPU_API_KEY=
# Allow plain http:// to a private network address (WireGuard, Tailscale). Leave false otherwise.
ALLOW_HTTP_MODEL_URLS=false

# ── Agent ───────────────────────────────────────────────────────────────────
# Model calls allowed per turn before the agent pauses and asks you to continue.
AGENT_MAX_STEPS=40
MAX_OUTPUT_TOKENS=8192
# Match the context window your server actually serves (Ollama: OLLAMA_CONTEXT_LENGTH,
# vLLM: --max-model-len). Older tool output is trimmed first when a task outgrows it.
CONTEXT_TOKENS=32000
# Optional sampling temperature; leave blank to use the model's default.
TEMPERATURE=

# ── Data and workspace ──────────────────────────────────────────────────────
# Conversations, memories and settings live in DATA_DIR/tatvam.db.
DATA_DIR=./data
# The folder the agent can read and edit. Point it at a project to do agentic coding there.
# Defaults to DATA_DIR/workspace.
WORKSPACE_DIR=

# ── Shell commands ──────────────────────────────────────────────────────────
# off (default) | docker (recommended: isolated container) | host (runs on this machine)
COMMAND_RUNNER=off
COMMAND_TIMEOUT_SECONDS=120
# Docker sandbox settings (used when COMMAND_RUNNER=docker)
DOCKER_PATH=docker
SANDBOX_IMAGE=node:24-bookworm
# The sandbox has no network unless this is true (needed for npm install, pip install, git clone).
SANDBOX_NETWORK=false
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
# Optional uid:gid for the container process, e.g. 1000:1000 on Linux hosts.
SANDBOX_USER=

# ── Sub-agents ──────────────────────────────────────────────────────────────
# How many sub-agents run at once (Ollama serves one request at a time unless
# OLLAMA_NUM_PARALLEL is raised; vLLM handles many) and how many steps each may take.
SUBAGENT_MAX_PARALLEL=3
SUBAGENT_MAX_STEPS=15

# ── Git ─────────────────────────────────────────────────────────────────────
# Lets the Changes panel open GitHub pull requests (needs the repo's "pull requests: write" scope).
GITHUB_TOKEN=

# ── MCP servers ─────────────────────────────────────────────────────────────
# JSON file listing MCP servers (Claude Desktop format). Defaults to DATA_DIR/mcp.json.
MCP_CONFIG=

# ── Remote access ───────────────────────────────────────────────────────────
# Leave empty to allow only http://127.0.0.1 / localhost (use an SSH tunnel from elsewhere).
# To serve on a real host name behind TLS, set both. Sign in at /login with ACCESS_TOKEN.
ALLOWED_HOSTS=
ACCESS_TOKEN=
# Optional: signs session cookies (defaults to a value derived from ACCESS_TOKEN).
SESSION_SECRET=

# ── Web ─────────────────────────────────────────────────────────────────────
# Web search: set one. SEARCH_PROVIDER picks explicitly (searxng | brave | tavily).
SEARCH_PROVIDER=
SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=
# web_fetch refuses private and loopback addresses unless this is true.
WEB_FETCH_ALLOW_PRIVATE=false
